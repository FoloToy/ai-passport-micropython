# FoloToy AI Passport: 8 MB QIO flash at 80 MHz.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESP32C3_REV_MIN_3=y
# Keep the standard MicroPython factory application and let the ESP32 port
# register the remaining flash as its VFS partition at runtime.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8MiB-ai-passport.csv"

CONFIG_LWIP_LOCAL_HOSTNAME="ai-passport"
